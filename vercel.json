{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/sitemap_index.xml", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/:wp(.*-sitemap\\d*\\.xml)", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/((?!api/|assets/|catalogo|sitemap\\.xml|robots\\.txt|_vercel).+)", "destination": "/", "permanent": true }
  ]
}
